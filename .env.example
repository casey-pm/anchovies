# Anchovies Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Slack Credentials
# Get these from your Slack app at https://api.slack.com/apps
# =============================================================================

# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Signing Secret (found in Basic Information)
SLACK_SIGNING_SECRET=your-signing-secret-here

# =============================================================================
# OPTIONAL: Slack Settings
# =============================================================================

# Default channel ID for posting (find in Slack channel details)
# SLACK_CHANNEL_ID=C0123456789

# =============================================================================
# OPTIONAL: Paths
# Override if your context files are in different locations
# =============================================================================

# Base path for context files (status, questions, etc.)
# CONTEXT_BASE=/home/user/project/context

# Path to persona profile YAML files
# PROFILES_DIR=/home/user/project/profiles

# Path to job description files
# JOB_DESCRIPTIONS_DIR=/home/user/project/job_descriptions

# =============================================================================
# OPTIONAL: Claude CLI
# =============================================================================

# Path to Claude CLI executable
# CLAUDE_CLI_PATH=claude

# Default model to use
# CLAUDE_MODEL=sonnet

# =============================================================================
# OPTIONAL: Session Settings
# =============================================================================

# Default team member for routing (lowercase)
# DEFAULT_MEMBER=marcus

# tmux session name
# TMUX_SESSION_NAME=anchovies

# Auto-close timeout in minutes
# SESSION_TIMEOUT_MINUTES=10

# Chat Hub persona (who coordinates)
# CHAT_HUB_PERSONA=marcus
